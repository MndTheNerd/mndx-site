---
import Section from './Section.astro';
import { rules } from '../content/rules';
import { repoFile } from '../content/site';
---

<Section id="what-changes" title="What changes">
  <ul class="rules">
    {rules.map((rule) => (
      <li class="rule">
        <svg class="glyph" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <path d="M2 8h9M8 4l4 4-4 4" />
        </svg>
        <h3>{rule.title}</h3>
        <p>{rule.body}</p>
        {rule.detailPath && (
          <a class="more" href={repoFile(rule.detailPath)}>
            More on {rule.title.toLowerCase()}
          </a>
        )}
      </li>
    ))}
  </ul>
</Section>

<style>
  .rules {
    display: grid;
    gap: var(--space-5) var(--space-5);
    padding: 0;
    list-style: none;
  }

  .rule {
    display: grid;
    align-content: start;
    grid-template-columns: 1.25rem minmax(0, 1fr);
    column-gap: var(--space-3);
    row-gap: var(--space-1);
  }

  .glyph {
    grid-row: 1;
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.2rem;
    fill: none;
    stroke: var(--proceed);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  h3,
  p,
  .more {
    grid-column: 2;
  }

  h3 {
    font-size: var(--step-1);
    font-weight: 600;
    line-height: 1.35;
  }

  p {
    color: var(--ink-muted);
  }

  .more {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    min-height: 1.75rem;
    font-size: var(--step--1);
  }

  @media (min-width: 700px) {
    .rules {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
