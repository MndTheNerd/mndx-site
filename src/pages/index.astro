---
import Base from '../layouts/Base.astro';
---

<Base
  title="MNDX: a solo product team inside Claude Code"
  description="MNDX is a Claude Code plugin that makes Claude spec, plan, test, verify and document every change, and stops it from editing code until you approve."
>
  <main>
    <h1>MNDX</h1>
  </main>
</Base>

<style>
  main {
    max-width: var(--content-max);
    margin-inline: auto;
    padding: var(--space-6) var(--gutter);
  }

  h1 {
    font-size: var(--step-5);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.02em;
  }
</style>
