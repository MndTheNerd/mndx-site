---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import Rules from '../components/Rules.astro';
import Commands from '../components/Commands.astro';
import Proof from '../components/Proof.astro';
import Limits from '../components/Limits.astro';
import Install from '../components/Install.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<Base
  title="MNDX: a solo product team inside Claude Code"
  description="MNDX is a Claude Code plugin that makes Claude spec, plan, test, verify and document every change, and stops it from editing code until you approve."
>
  <SiteHeader />
  <main id="main">
    <Hero />
    <Rules />
    <Commands />
    <Proof />
    <Limits />
    <Install />
  </main>
  <SiteFooter />
</Base>

<style>
  main {
    max-width: var(--content-max);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
</style>
